# Banco de dados PostgreSQL (no Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Endereço público do sistema (trocar pelo domínio do cliente na entrega)
APP_URL=http://localhost:3800

# Segredo das sessões de login (texto aleatório com 32+ caracteres; um diferente por ambiente)
SESSION_SECRET=troque-por-um-texto-aleatorio-com-mais-de-32-caracteres

# Chave que criptografa CPF/CNPJ e chave Pix dos investidores (64 caracteres hexadecimais).
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Perder esta chave = perder esses dados. Guardar no cofre.
DADOS_CHAVE=

# Primeiro administrador, criado sozinho quando ainda não existe nenhum usuário
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=admin@havenergia.com.br
INITIAL_ADMIN_PASSWORD=troque-esta-senha

# Acesso pelo roteador de *.sistemainterno.app: mesma chave do roteador (IP real do cliente)
ROTEADOR_CHAVE=

# Backup diário: serviço separado (pasta backup/). No sistema, só o monitoramento:
# "sim" faz o sino avisar se o último backup tiver mais de 36 h.
BACKUP_MONITORAR=
